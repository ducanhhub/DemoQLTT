/* ========================================================================
GLOBAL RESETS & MAIN WINDOW
======================================================================== */
QMainWindow,
QWidget#centralwidget {
    background-color: #0b1329;
    color: #f8fafc;
    font-family: "Segoe UI", "Segoe UI Variable", "SF Pro Display", -apple-system, sans-serif;
    font-size: 13px;
}

/* ========================================================================
TAB WIDGET & TAB BAR
======================================================================== */
QTabWidget::pane {
    border: 1px solid #1e293b;
    background-color: #0b1329;
    border-radius: 8px;
    top: -1px;
}

QTabBar::tab {
    background-color: #1e293b;
    color: #94a3b8;
    padding: 10px 18px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 600;
    font-size: 13px;
    border: 1px solid #334155;
    border-bottom: none;
}

QTabBar::tab:hover {
    background-color: #334155;
    color: #38bdf8;
}

QTabBar::tab:selected {
    background-color: #0f172a;
    color: #38bdf8;
    border-top: 3px solid #38bdf8;
    border-left: 1px solid #334155;
    border-right: 1px solid #334155;
}

/* ========================================================================
GROUP BOXES & CARDS CONTAINERS
======================================================================== */
QGroupBox {
    background-color: #111c38;
    border: 1px solid #1e293b;
    border-radius: 10px;
    margin-top: 24px;
    font-weight: bold;
    font-size: 14px;
    color: #38bdf8;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 4px 12px;
    background-color: #1e293b;
    color: #38bdf8;
    border-radius: 6px;
    border: 1px solid #334155;
    left: 15px;
}

QFrame#cardQuyenGop,
QFrame#cardGiaiNgan,
QFrame#cardSoDu,
QFrame#cardChienDich,
QFrame#frame,
QFrame#frame_2,
QFrame#frameNganKho {
    background-color: #111c38;
    border: 1px solid #1e293b;
    border-radius: 10px;
}

QFrame#cardQuyenGop:hover,
QFrame#cardGiaiNgan:hover,
QFrame#cardSoDu:hover,
QFrame#cardChienDich:hover {
    border: 1px solid #38bdf8;
}

/* ========================================================================
LABELS
======================================================================== */
QLabel {
    color: #cbd5e1;
    font-size: 13px;
    border: none;
    background: transparent;
}

QLabel#lblTongQuyenGop,
QLabel#lblTongGiaiNgan,
QLabel#lblSoDuKhaDung {
    color: #4ade80;
    font-size: 18px;
    font-weight: bold;
}

QLabel#label_58 {
    color: #38bdf8;
    font-size: 18px;
    font-weight: bold;
}

QLabel#txtTongQuyenGop,
QLabel#txtSoTienConLai {
    color: #4ade80;
    font-weight: bold;
    font-size: 14px;
}

QLabel#txtBanGhi {
    color: #38bdf8;
    font-weight: bold;
    font-size: 14px;
}

/* ========================================================================
INPUT CONTROLS (QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox)
======================================================================== */
QLineEdit,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QComboBox {
    background-color: #0f172a;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 5px 8px;
    font-size: 13px;
    selection-background-color: #0284c7;
    selection-color: #ffffff;
}

QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QDateEdit:focus,
QComboBox:focus {
    border: 1px solid #38bdf8;
    background-color: #131f37;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QComboBox:disabled {
    background-color: #090d16;
    color: #64748b;
    border: 1px solid #1e293b;
}

/* Custom QComboBox with White Down Arrow Indicator */
QComboBox {
    padding-right: 28px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border: none;
    background: transparent;
}

QComboBox::down-arrow {
    image: url("data:image/svg+xml;base64,");
    width: 12px;
    height: 12px;
    margin-right: 6px;
}

QComboBox::down-arrow:on {
    top: 1px;
    left: 1px;
}

QComboBox QAbstractItemView {
    background-color: #111c38;
    color: #f8fafc;
    border: 1px solid #334155;
    selection-background-color: #0284c7;
    selection-color: #ffffff;
    border-radius: 6px;
    padding: 4px;
    outline: 0px;
}

/* Custom QDateEdit Drop-down Indicator */
QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 25px;
    border: none;
    background: transparent;
}

QDateEdit::down-arrow {
    image: url("data:image/svg+xml;base64,");
    width: 12px;
    height: 12px;
    margin-right: 6px;
}

/* ========================================================================
PUSH BUTTONS
======================================================================== */
QPushButton {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #0284c7;
    color: #ffffff;
    border-color: #38bdf8;
}

QPushButton:pressed {
    background-color: #0369a1;
}

QPushButton:disabled {
    background-color: #0f172a;
    color: #475569;
    border-color: #1e293b;
}

/* Custom Highlight Action Buttons */
QPushButton#btnThemCD,
QPushButton#btnLuuQG,
QPushButton#btnTaoHS,
QPushButton#btnXanNhanGiaiNgan,
QPushButton#btnTaiBaoCao {
    background-color: #0284c7;
    color: #ffffff;
    border: 1px solid #38bdf8;
}

QPushButton#btnThemCD:hover,
QPushButton#btnLuuQG:hover,
QPushButton#btnTaoHS:hover,
QPushButton#btnXanNhanGiaiNgan:hover,
QPushButton#btnTaiBaoCao:hover {
    background-color: #0369a1;
}

QPushButton#btnDuyetHS,
QPushButton#btnDoiSoat {
    background-color: #059669;
    color: #ffffff;
    border: 1px solid #34d399;
}

QPushButton#btnDuyetHS:hover,
QPushButton#btnDoiSoat:hover {
    background-color: #047857;
}

QPushButton#btnTuChoi,
QPushButton#btnTuChoiHS,
QPushButton#btnXoa,
QPushButton#btnXoaNhanSu {
    background-color: #dc2626;
    color: #ffffff;
    border: 1px solid #f87171;
}

QPushButton#btnTuChoi:hover,
QPushButton#btnTuChoiHS:hover,
QPushButton#btnXoa:hover,
QPushButton#btnXoaNhanSu:hover {
    background-color: #b91c1c;
}

QPushButton#btnThemNHTQuick,
QPushButton#btnThemNTHQuick {
    background-color: #0891b2;
    color: #ffffff;
    font-size: 14px;
    font-weight: bold;
    border-radius: 4px;
    padding: 2px;
}

/* Action Buttons inside Table Cells (e.g., Nút Xóa, In BB trong Bảng) */
QTableWidget QPushButton {
    background-color: #ef4444;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 1px 8px;
    font-size: 11px;
    font-weight: bold;
    min-height: 20px;
    max-height: 22px;
}

QTableWidget QPushButton:hover {
    background-color: #dc2626;
}

QTableWidget QWidget {
    background: transparent;
}

/* ========================================================================
TABLE WIDGETS
======================================================================== */
QTableWidget {
    background-color: #0f172a;
    color: #e2e8f0;
    gridline-color: #1e293b;
    border: 1px solid #1e293b;
    border-radius: 8px;
    selection-background-color: #1e3a8a;
    selection-color: #ffffff;
    font-size: 12px;
}

QTableWidget::item {
    padding: 4px 6px;
    border-bottom: 1px solid #1e293b;
}

QTableWidget::item:selected {
    background-color: #1d4ed8;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #1e293b;
    color: #38bdf8;
    padding: 6px 8px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #334155;
    border-right: 1px solid #1e293b;
    font-size: 12px;
}

QHeaderView::section:horizontal {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

/* ========================================================================
SCROLL AREA & SCROLLBARS
======================================================================== */
QScrollArea {
    background: transparent;
    border: none;
}

QScrollBar:vertical {
    border: none;
    background-color: #0f172a;
    width: 8px;
    border-radius: 4px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #334155;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #38bdf8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    border: none;
    background-color: #0f172a;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #334155;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #38bdf8;
}

/* ========================================================================
PROGRESS BAR
======================================================================== */
QProgressBar {
    background-color: #0f172a;
    border-radius: 6px;
    border: 1px solid #1e293b;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background-color: #0284c7;
    border-radius: 6px;
}